APP_NAME=LinkedIn API
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
APP_DEBUG=false
CORS_ALLOW_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
CORS_ALLOW_ORIGIN_REGEX=.*
AUTH_JWT_SECRET_KEY=change-me-in-production
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=30
AUTH_ACCESS_COOKIE_NAME=access_token
AUTH_REFRESH_COOKIE_NAME=refresh_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Supabase Postgres URL:
# - Use the direct connection string for a long-running backend if your host supports IPv6.
# - Use Supavisor session mode on port 5432 if your host is IPv4-only.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_ECHO=false
DATABASE_POOL_PRE_PING=true
DATABASE_CHECK_ON_STARTUP=true
DATABASE_FAIL_FAST=false
# Redis queueing is disabled for the low-user deployment.
# REDIS_URL=redis://localhost:6379/0
# KNOWLEDGE_QUEUE_NAME=queue:knowledge-ingestion
# KNOWLEDGE_PROCESSING_QUEUE_NAME=queue:knowledge-ingestion:processing
# KNOWLEDGE_DEAD_LETTER_QUEUE_NAME=queue:knowledge-ingestion:dead-letter
# KNOWLEDGE_WORKER_POLL_SECONDS=2
# KNOWLEDGE_WORKER_MAX_ATTEMPTS=3
# KNOWLEDGE_REQUEUE_DEAD_LETTER_ON_STARTUP=true
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=knowledge-base
MINIO_PRESIGNED_URL_SECONDS=900
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=knowledge_chunks
QDRANT_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
KNOWLEDGE_CHUNK_SIZE_TOKENS=800
KNOWLEDGE_CHUNK_OVERLAP_TOKENS=160
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
APIFY_API_TOKEN=your_apify_token
GLASSDOOR_ACTOR_ID=5OaooRg0FxlRF0L1B
# GLASSDOOR_QUEUE_NAME=queue:actors
GLASSDOOR_SOURCE_SITE=glassdoor
WELLFOUND_ACTOR_ID=jV4Y8h6j3AqVj5Qur
# WELLFOUND_QUEUE_NAME=queue:wellfound-actors
WELLFOUND_SOURCE_SITE=wellfound
WORKABLE_ACTOR_ID=hXENKfdQC3e6E9ecv
# WORKABLE_QUEUE_NAME=queue:workable-actors
WORKABLE_SOURCE_SITE=workable
